model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Model

	annotation PBI_QueryGroupOrder = 0

queryGroup Fact

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 3

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 4

queryGroup Staging

	annotation PBI_QueryGroupOrder = 5

annotation PBI_QueryOrder = ["FactSalesLine", "FactPurchaseLine", "FactTradeTerm", "FactTradeTermMonth", "FactCreditNote", "FactServiceInvoice", "DimProduct", "DimBrand", "DimPartner", "DimOutlet", "DimOrgUnit", "DimDocumentType", "DimDate", "Measure", "HTML", "Labels", "LabelMeasures", "pServer", "pDatabase", "TradeTerms"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","CalcGroup","TMDLView_Desktop","WebModelingEdit","DevMode","MCP-PBIModeling"]

annotation __TEdtr = 1

ref table FactSalesLine
ref table FactPurchaseLine
ref table FactTradeTerm
ref table FactTradeTermMonth
ref table FactCreditNote
ref table FactServiceInvoice
ref table DimProduct
ref table DimBrand
ref table DimPartner
ref table DimOutlet
ref table DimOrgUnit
ref table DimDocumentType
ref table DimDate
ref table Measure
ref table HTML
ref table Labels
ref table LabelMeasures

ref cultureInfo en-US
