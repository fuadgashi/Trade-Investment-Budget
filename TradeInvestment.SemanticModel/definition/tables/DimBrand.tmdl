/// Brands, with their division and the four rates the selling price sets aside: distribution cost, distribution profit, annual bonus and secondary position.
table DimBrand
	lineageTag: 94b4e778-1632-4074-b579-3d0df35adb49

	/// Brand code.
	column BrandId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 33b21b2e-5001-4bdf-8596-69ebd0848c8b
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Brand name.
	column BrandName
		dataType: string
		isAvailableInMdx: false
		lineageTag: a28c622a-eefc-420d-afd6-e03b58bfd141
		isDefaultLabel
		summarizeBy: none
		sourceColumn: BrandName

		annotation SummarizationSetBy = Automatic

	/// Commercial division the brand belongs to.
	column DivisionName
		dataType: string
		isAvailableInMdx: false
		lineageTag: ab7a97bf-7ac2-4307-ad50-b480f3bddcd9
		summarizeBy: none
		sourceColumn: DivisionName

		annotation SummarizationSetBy = Automatic

	/// Distribution cost the price sets aside, as a share of the net price without VAT.
	column DistributionCostRate
		dataType: double
		isHidden
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: d3836b4c-2696-4661-b9c4-f98b710d98b4
		summarizeBy: none
		sourceColumn: DistributionCostRate

		annotation SummarizationSetBy = Automatic

	/// Distribution profit the price sets aside, as a share of the net price without VAT.
	column DistributionProfitRate
		dataType: double
		isHidden
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: e3d7f906-3678-4bd9-bd88-05bf7607235c
		summarizeBy: none
		sourceColumn: DistributionProfitRate

		annotation SummarizationSetBy = Automatic

	/// Annual bonus the price sets aside, as a share of the net price without VAT.
	column AnnualBonusRate
		dataType: double
		isHidden
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: ff95d5d2-2c5e-47e9-83e8-452d2ef0bca8
		summarizeBy: none
		sourceColumn: AnnualBonusRate

		annotation SummarizationSetBy = Automatic

	/// Secondary-position money the price sets aside, as a share of the net price without VAT.
	column SecondaryPositionRate
		dataType: double
		isHidden
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: 63ad588b-46be-42f7-832f-4c3505154916
		summarizeBy: none
		sourceColumn: SecondaryPositionRate

		annotation SummarizationSetBy = Automatic
	partition DimBrand = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Brands with their division and the four rates of the price calculation, all kept in the source.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    b.BrandId,
				                    b.BrandName,
				                    b.DivisionName,
				                    -- the rates live once, here: every measure and label reads them, none repeats a number
				                    CAST(b.DistributionCostRate AS FLOAT) AS DistributionCostRate,
				                    CAST(b.DistributionProfitRate AS FLOAT) AS DistributionProfitRate,
				                    CAST(b.AnnualBonusRate AS FLOAT) AS AnnualBonusRate,
				                    CAST(b.SecondaryPositionRate AS FLOAT) AS SecondaryPositionRate
				                FROM ti.Brand b
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"BrandId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

