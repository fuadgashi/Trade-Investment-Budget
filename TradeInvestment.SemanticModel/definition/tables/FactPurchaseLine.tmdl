/// Purchase document lines, goods only: the supplier price the Calculation page sets beside the selling prices. Window: 1 January of the prior year onwards.
table FactPurchaseLine
	lineageTag: 4862527a-963e-4b0f-a783-e7f856ed8a0b

	/// Document type code. Joins to DimDocumentType, which carries the purchase flag.
	column DocumentTypeId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 7353be61-fa5d-43bf-8c17-ae2b156a78f8
		summarizeBy: none
		sourceColumn: DocumentTypeId

		annotation SummarizationSetBy = Automatic

	/// Organisational unit that received the goods. Joins to DimOrgUnit.
	column OrgUnitId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: f6de5e56-6c32-4c90-a0eb-f4988af276d5
		summarizeBy: none
		sourceColumn: OrgUnitId

		annotation SummarizationSetBy = Automatic

	/// Document date. Joins to DimDate.
	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		isAvailableInMdx: false
		lineageTag: fac3fbb9-b2df-489d-9da0-fc8170a09135
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Product code. Joins to DimProduct.
	column ProductId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: f47222c7-9b5c-4b35-9823-9fc97f7f6b2b
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = Automatic

	/// Quantity bought, in the product's base unit.
	column Quantity
		dataType: double
		isHidden
		isAvailableInMdx: false
		lineageTag: 7f3e01f1-672b-40d1-9c6e-77220acded23
		summarizeBy: none
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	/// Supplier price per unit without VAT, after the supplier's discounts: what the supplier charged, not the landed cost.
	column SupplierPrice
		dataType: double
		isHidden
		isAvailableInMdx: false
		lineageTag: 3e83b0f5-3fa0-4e77-96e2-9f51b6a66200
		summarizeBy: none
		sourceColumn: SupplierPrice

		annotation SummarizationSetBy = Automatic
	partition FactPurchaseLine = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    // Purchase document lines from 1 January of the prior year, goods only.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    l.DocumentTypeId,
				                    l.OrgUnitId,
				                    CAST(l.DocumentDate AS DATE) AS [Date],
				                    l.ProductId,
				                    CAST(l.Quantity AS FLOAT) AS Quantity,
				                    CAST(l.SupplierUnitPrice AS FLOAT) AS SupplierPrice
				                FROM ti.PurchaseLine l
				                INNER JOIN ti.Product p
				                    ON p.ProductId = l.ProductId
				                WHERE l.DocumentDate >= DATEFROMPARTS(YEAR(GETDATE()) - 1, 1, 1)
				                  AND p.IsGoods = 1
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Typed = Table.TransformColumnTypes(Source, {{"Date", type date}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

