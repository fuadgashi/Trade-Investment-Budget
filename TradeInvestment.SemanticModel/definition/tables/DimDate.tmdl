/// The calendar: one row per day of the prior and the current year, marked as the date table. Working Day holds the working-day rule.
table DimDate
	lineageTag: ef8fc617-08c5-4420-ac39-dbc880a88275
	dataCategory: Time

	/// Calendar year.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: 196fc928-8388-4a46-882c-87a4f75e0a68
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	/// Month number, 1-12. Sorts the month name.
	column Month
		dataType: int64
		formatString: 0
		lineageTag: 396b7eee-9513-463e-962a-5dfe0226a20a
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = User

	/// The date. This is the marked date column and the key every fact joins to.
	column Date
		dataType: dateTime
		isKey
		formatString: dd/mm
		lineageTag: 09f77d0a-1936-4c63-95bc-2e307bdac650
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// Quarter number, 1-4. Sorts the quarter name.
	column Quarter
		dataType: int64
		formatString: 0
		lineageTag: 822f1eab-6a0c-481f-83d1-60afce447d1f
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = User

	/// Week of year, Monday start; week 1 is the week holding 1 January. Sorts the week name.
	column Week
		dataType: int64
		formatString: 0
		lineageTag: 0d385754-24e0-4a1a-b6c1-eadd728ddad5
		summarizeBy: none
		sourceColumn: Week

		annotation SummarizationSetBy = User

	/// Day of month, 1-31.
	column DayMonth
		dataType: int64
		formatString: 0
		lineageTag: 453a3dbb-8133-4e5a-808b-fc7b598ce5a4
		summarizeBy: none
		sourceColumn: DayMonth

		annotation SummarizationSetBy = User

	/// Month label, "Jan"-"Dec" (en-US).
	column 'Month Name'
		dataType: string
		lineageTag: 73faafd3-8a24-4d97-afc3-cf4c911dd327
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: Month

		annotation SummarizationSetBy = User

	/// Running count of working days (Monday to Saturday) within the month, up to this date.
	column 'Month Working Day'
		dataType: int64
		formatString: 0
		lineageTag: 64b878a1-86db-4a6f-b074-16ebfd6c8bfd
		summarizeBy: none
		sourceColumn: Month Working Day

		annotation SummarizationSetBy = User

	/// Total working days (Monday to Saturday) in the calendar year.
	column 'Working Days'
		dataType: int64
		formatString: 0
		lineageTag: 9e7b8a6b-0297-4694-8b45-669686a6f87f
		summarizeBy: none
		sourceColumn: Working Days

		annotation SummarizationSetBy = User

	/// Day of year, 1-366.
	column 'Day Year'
		dataType: int64
		formatString: 0
		lineageTag: 2ea670db-e16a-4900-b0e9-b424bf111963
		summarizeBy: none
		sourceColumn: Day Year

		annotation SummarizationSetBy = User

	/// Week of month, Monday start.
	column 'Week Month'
		dataType: int64
		formatString: 0
		lineageTag: 96dd6044-3ac8-4f19-8622-292c1961126d
		summarizeBy: none
		sourceColumn: Week Month

		annotation SummarizationSetBy = User

	/// Two-letter day initial, "Mo"-"Su".
	column 'Day Initial'
		dataType: string
		lineageTag: 85cf7a6a-4b04-4eaa-8f0e-788a1675a95c
		summarizeBy: none
		sourceColumn: Day Initial
		sortByColumn: 'Day Week'

		annotation SummarizationSetBy = User

	/// Day of week, 1 (Mon) to 7 (Sun). Sorts the day columns.
	column 'Day Week'
		dataType: int64
		formatString: 0
		lineageTag: bb2b0fae-7f72-464b-8a06-3d9f8eb386b5
		summarizeBy: none
		sourceColumn: Day Week

		annotation SummarizationSetBy = User

	/// Day label, "Mon"-"Sun" (en-US).
	column Day
		dataType: string
		lineageTag: 51808463-cd59-49a5-af21-565750430e75
		summarizeBy: none
		sourceColumn: Day
		sortByColumn: 'Day Week'

		annotation SummarizationSetBy = User

	/// Month and year display label, "MM/YYYY".
	column 'Month Year'
		dataType: string
		lineageTag: 909748b5-1d6d-465d-958f-58894eea6250
		summarizeBy: none
		sourceColumn: Month Year
		sortByColumn: YearMonthKey

		annotation SummarizationSetBy = User

	/// Week label, "Week 1".
	column 'Week Name'
		dataType: string
		lineageTag: 7b768188-6545-4faa-b6fb-66de9b794d5a
		summarizeBy: none
		sourceColumn: Week Name
		sortByColumn: Week

		annotation SummarizationSetBy = User

	/// Quarter label, "Q1"-"Q4".
	column 'Quarter Name'
		dataType: string
		lineageTag: ac08a8c9-5430-4557-a7b0-01e694b44304
		summarizeBy: none
		sourceColumn: Quarter Name
		sortByColumn: Quarter

		annotation SummarizationSetBy = User

	/// Sort key for Month Year, YYYYMM. Hidden.
	column YearMonthKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e88dbce1-0e41-4a86-af6d-799fce8d38ec
		summarizeBy: none
		sourceColumn: YearMonthKey

		annotation SummarizationSetBy = User

	/// 1 on a working day (Monday to Saturday), 0 on Sunday. The working-day rule lives in the DimDate query; count working days as the SUM of this column.
	column 'Working Day'
		dataType: int64
		formatString: 0
		lineageTag: f611520d-5374-4089-98ec-063537a6f9b3
		summarizeBy: none
		sourceColumn: Working Day

		annotation SummarizationSetBy = User

	/// Running count of working days from the first calendar date to this date. Working days between two dates = index(end) - index(start) + Working Day(start). Lets AvgDay count days per product without scanning the calendar.
	column 'Working Day Index'
		dataType: int64
		formatString: 0
		lineageTag: a23d9085-309e-4110-b8b1-b5ee69e0cd55
		summarizeBy: none
		sourceColumn: Working Day Index

		annotation SummarizationSetBy = User

	/// Monday of the week the date falls in: one value per calendar week, also across New Year, where Week restarts at 1. AvgWeek counts weeks with it. Hidden.
	column 'Week Start'
		dataType: dateTime
		isHidden
		formatString: dd/mm
		lineageTag: 1f39191f-5357-425e-8f29-b4fa58dc70db
		summarizeBy: none
		sourceColumn: Week Start

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	hierarchy 'Date Hierarchy'
		lineageTag: daeb4fb2-81f5-4c73-a313-201a3e13a127

		level Quarter
			lineageTag: e2447647-5794-4012-8edd-b6486c1494ea
			column: Quarter

		level Month
			lineageTag: 0cbdf0f8-dcb7-447d-8186-ec7d18cd52fd
			column: Month

		level Week
			lineageTag: b57d1171-8f05-4d9d-856a-3dd7cd5f6753
			column: Week

		level Date
			lineageTag: b1e9f2f0-0221-42dd-b690-171946052f73
			column: Date

	partition DimDate = m
		mode: import
		queryGroup: Model
		source =
				let
				    // The calendar: one row per day, calendar year only.
				    // The range is the fact window restated - 1 January of the prior year to the end of the
				    // current year - not read from a fact table: a calendar derived from a fact query depends on
				    // that query and goes short with no error when it returns nothing. If the fact window
				    // changes, change it here too.
				    CurrentYear = Date.Year(DateTime.LocalNow()),
				    StartDate = #date(CurrentYear - 1, 1, 1),
				    EndDate = #date(CurrentYear, 12, 31),
				    NumberOfDays = Duration.Days(EndDate - StartDate) + 1,
				    Calendar = List.Dates(StartDate, NumberOfDays, #duration(1, 0, 0, 0)),
				    TableFromList = Table.FromList(Calendar, Splitter.SplitByNothing(), {"Date"}),
				
				    // -- Calendar columns -------------------------------------------------
				    // Culture is explicit on every name-producing call: without it these
				    // return the names of whichever machine refreshes, so the same file
				    // would yield different values on different desks.
				    Year = Table.AddColumn(TableFromList, "Year", each Date.Year([Date]), Int64.Type),
				    Quarter = Table.AddColumn(Year, "Quarter", each Date.QuarterOfYear([Date]), Int64.Type),
				    Month = Table.AddColumn(Quarter, "Month", each Date.Month([Date]), Int64.Type),
				    Week = Table.AddColumn(Month, "Week", each Date.WeekOfYear([Date], Day.Monday), Int64.Type),
				    DayMonth = Table.AddColumn(Week, "DayMonth", each Date.Day([Date]), Int64.Type),
				    QuarterName = Table.AddColumn(DayMonth, "Quarter Name", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    MonthName = Table.AddColumn(QuarterName, "Month Name", each Text.Start(Date.MonthName([Date], "en-US"), 3), type text),
				    WeekName = Table.AddColumn(MonthName, "Week Name", each "Week " & Text.From([Week]), type text),
				    DayCol = Table.AddColumn(WeekName, "Day", each Text.Start(Date.DayOfWeekName([Date], "en-US"), 3), type text),
				    WeekMonth = Table.AddColumn(DayCol, "Week Month", each Date.WeekOfMonth([Date], Day.Monday), Int64.Type),
				    DayWeek = Table.AddColumn(WeekMonth, "Day Week", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    DayYear = Table.AddColumn(DayWeek, "Day Year", each Date.DayOfYear([Date]), Int64.Type),
				    MonthYear = Table.AddColumn(DayYear, "Month Year", each Text.PadStart(Text.From(Date.Month([Date])), 2, "0") & "/" & Text.From(Date.Year([Date])), type text),
				    YearMonthKey = Table.AddColumn(MonthYear, "YearMonthKey", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    // Monday of the week: one key per calendar week, across New Year too (Week restarts at 1).
				    WeekStart = Table.AddColumn(YearMonthKey, "Week Start", each Date.StartOfWeek([Date], Day.Monday), type date),
				
				    // Derived from the Day Week number rather than the Day text, so it does
				    // not break if the day label ever changes length or culture.
				    DayInitial = Table.AddColumn(WeekStart, "Day Initial", each
				        let n = Date.DayOfWeek([Date], Day.Monday) + 1
				        in if n = 1 then "Mo" else if n = 2 then "Tu" else if n = 3 then "We"
				           else if n = 4 then "Th" else if n = 5 then "Fr" else if n = 6 then "Sa"
				           else "Su", type text),
				
				    // -- Working days ------------------------------------------------------
				    // The working week, defined once: every working-day count in the model reads the
				    // columns built from it.
				    WorkingWeekdays = {Day.Monday, Day.Tuesday, Day.Wednesday, Day.Thursday, Day.Friday, Day.Saturday},
				    IsWorkingDay = (d as date) as logical => List.Contains(WorkingWeekdays, Date.DayOfWeek(d, Day.Sunday)),
				    WorkingDay = Table.AddColumn(DayInitial, "Working Day", each if IsWorkingDay([Date]) then 1 else 0, Int64.Type),
				    MonthWorkingDay = Table.AddColumn(WorkingDay, "Month Working Day", each List.Count(
				        List.Select(
				            List.Dates(
				                #date(Date.Year([Date]), Date.Month([Date]), 1),
				                Duration.Days([Date] - #date(Date.Year([Date]), Date.Month([Date]), 1)) + 1,
				                #duration(1, 0, 0, 0)
				            ),
				            each IsWorkingDay(_)
				        )
				    ), Int64.Type),
				    WorkingDays = Table.AddColumn(MonthWorkingDay, "Working Days", each let
				            YearStart = #date(Date.Year([Date]), 1, 1),
				            YearEnd = #date(Date.Year([Date]), 12, 31),
				            YearDays = List.Dates(YearStart, Duration.Days(YearEnd - YearStart) + 1, #duration(1, 0, 0, 0)),
				            WorkingDaysInYear = List.Select(YearDays, IsWorkingDay)
				        in
				            List.Count(WorkingDaysInYear), Int64.Type),
				
				    // Running count of working days since the calendar starts (same rule). The working days
				    // between two dates are index(end) - index(start) + Working Day(start): a lookup, not a
				    // scan of the calendar, so a per-product day count stays fast.
				    Flags = List.Buffer(List.Transform(Calendar, each if IsWorkingDay(_) then 1 else 0)),
				    RunningIndex = List.Buffer(List.Generate(
				        () => [i = 0, s = Flags{0}],
				        each [i] < List.Count(Flags),
				        each [i = [i] + 1, s = [s] + Flags{[i] + 1}],
				        each [s]
				    )),
				    RowPos = Table.AddIndexColumn(WorkingDays, "RowPos", 0, 1, Int64.Type),
				    WorkingDayIndex = Table.RemoveColumns(
				        Table.AddColumn(RowPos, "Working Day Index", each RunningIndex{[RowPos]}, Int64.Type),
				        {"RowPos"}
				    ),
				    ChangeType = Table.TransformColumnTypes(WorkingDayIndex, {{"Date", type date}})
				in
				    ChangeType

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

