/// Organisational units: the warehouses and vans documents are booked in.
table DimOrgUnit
	lineageTag: 9f5bcb1d-79ae-4d14-aff5-52f5a33ba7c3

	/// Organisational unit code.
	column OrgUnitId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 37fa5f72-b512-4155-96a6-1ff3e664edbd
		summarizeBy: none
		sourceColumn: OrgUnitId

		annotation SummarizationSetBy = Automatic

	/// Organisational unit name. Sorted by OrgUnitSortOrder.
	column OrgUnitName
		dataType: string
		isAvailableInMdx: false
		lineageTag: c7b21ee5-7416-4a88-bb40-68c2c92ea04c
		isDefaultLabel
		summarizeBy: none
		sourceColumn: OrgUnitName
		sortByColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of OrgUnitName, from the source: one position per unit name.
	column OrgUnitSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f6df6029-d34d-4d5d-8ebe-721cb55ea841
		summarizeBy: none
		sourceColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic
	partition DimOrgUnit = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Organisational units: warehouses and vans.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    o.OrgUnitId,
				                    o.OrgUnitName,
				                    o.SortOrder AS OrgUnitSortOrder
				                FROM ti.OrgUnit o
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"OrgUnitId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

