	/// Page subtitle, with the current bonus and position rates filled in: Labels row Page 3, Subtitle, in the viewer's culture.
	measure 'Page 3 | Subtitle' =
			VAR _text = LabelText( "Subtitle", "Page", 3 )
			RETURN
			    -- rates are not written into the text: the label carries a placeholder filled from DimBrand
			    SUBSTITUTE (
			        SUBSTITUTE ( _text, "{BonusRate}", FORMAT ( [Bonus Price Rate], "0.0%", "en-US" ) ),
			        "{PositionRate}", FORMAT ( [Position Rate], "0.0%", "en-US" )
			    )
		displayFolder: Subtitles\Page
		lineageTag: 8b25bd3a-09c1-4834-8cf3-04c8496b2b90

		annotation PBI_FormatHint = {"isText":true}

