	/// Visual subtitle, with the current bonus and position rates filled in: Labels row Visual 67, VisualSubtitle, in the viewer's culture.
	measure 'Position Customer | VisualSubtitle' =
			VAR _text = LabelText( "VisualSubtitle", "Visual", 67 )
			RETURN
			    -- rates are not written into the text: the label carries a placeholder filled from DimBrand
			    SUBSTITUTE (
			        SUBSTITUTE ( _text, "{BonusRate}", FORMAT ( [Bonus Price Rate], "0.0%", "en-US" ) ),
			        "{PositionRate}", FORMAT ( [Position Rate], "0.0%", "en-US" )
			    )
