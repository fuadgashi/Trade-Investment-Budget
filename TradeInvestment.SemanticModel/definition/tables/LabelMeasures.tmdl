/// One text measure per UI label of the report, each a LabelText lookup against Labels in the viewer's culture.
table LabelMeasures
	lineageTag: e4b4d359-5f81-4bc5-82b8-ed3b148ef311

	/// The culture every label is read in. The report is English only, so this is en-US; to add a language, add its rows to Labels and return the viewer's culture here.
	measure 'User Culture' = "en-US"
		displayFolder: Culture
		lineageTag: 6a933d20-9854-4687-a9d9-f46ad423f487

		annotation PBI_FormatHint = {"isText":true}

