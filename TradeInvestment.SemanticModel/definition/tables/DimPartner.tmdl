/// Business partners: the customers that own the outlets, and the suppliers on credit notes received and service invoices.
table DimPartner
	lineageTag: 29d54f3d-e5de-4f5d-848b-2ccd0ae2a442

	/// Partner code.
	column PartnerId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: f3b2580b-e809-4c57-8a99-716791896182
		summarizeBy: none
		sourceColumn: PartnerId

		annotation SummarizationSetBy = Automatic

	/// Partner name. Sorted by PartnerSortOrder.
	column PartnerName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 21d8b4dc-6c02-478b-9b1f-5bf8f2910428
		isDefaultLabel
		summarizeBy: none
		sourceColumn: PartnerName
		sortByColumn: PartnerSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of PartnerName, from the source: one position per partner name.
	column PartnerSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9fa85382-9401-41d2-bf92-e045d18702e9
		summarizeBy: none
		sourceColumn: PartnerSortOrder

		annotation SummarizationSetBy = Automatic
	partition DimPartner = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Business partners: customers and suppliers.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    p.PartnerId,
				                    p.PartnerName,
				                    p.SortOrder AS PartnerSortOrder
				                FROM ti.Partner p
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"PartnerId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

