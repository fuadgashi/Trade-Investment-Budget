/// Document types, with the flags that say which documents are sales and which are purchases.
table DimDocumentType
	lineageTag: d92d58ef-f74d-47d7-a812-40248f218b86

	/// Document type code.
	column DocumentTypeId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 64095179-a875-4f5c-8423-298fc5134f60
		summarizeBy: none
		sourceColumn: DocumentTypeId

		annotation SummarizationSetBy = Automatic

	/// Document type name.
	column DocumentTypeName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 30a40893-d9f3-4df2-a37a-2c391da6a621
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DocumentTypeName

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that move goods out to a customer, returns included. Every sales measure filters on it.
	column IsSalesOut
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: c511b740-f96d-4b1e-b9af-384e3f79adb3
		summarizeBy: none
		sourceColumn: IsSalesOut

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that bring goods in from a supplier. Supplier Price filters on it.
	column IsPurchase
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: b0120e0a-22c6-4a64-bc77-d3baa9409b11
		summarizeBy: none
		sourceColumn: IsPurchase

		annotation SummarizationSetBy = Automatic
	partition DimDocumentType = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Document types, with the sales and purchase flags kept in the source.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    t.DocumentTypeId,
				                    t.DocumentTypeName,
				                    -- a document type the source adds arrives unflagged and counts in no total until it is flagged
				                    t.IsSalesOut,
				                    t.IsPurchase
				                FROM ti.DocumentType t
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DocumentTypeId"}, true),
				    Typed = Table.TransformColumnTypes(Keyed, {{"IsSalesOut", type logical}, {"IsPurchase", type logical}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

