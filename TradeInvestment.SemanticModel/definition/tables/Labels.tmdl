				        {"Visual", 13, "Accumulated and Spent", "en-US", "MeasureLabel", "Accumulated and spent"},
				        {"Visual", 14, "Alt Bonus Accumulated", "en-US", "VisualSubtitle", "Card: the annual bonus the price has set aside so far in the Current Year, split into customers with and without a bonus term, with the projection to year end."},
				        {"Visual", 15, "Alt Bonus Customer", "en-US", "VisualSubtitle", "Table of customers with a bonus term: sales, spent rate, bonus spent, accumulated and difference."},
				        {"Visual", 16, "Alt Bonus Customers", "en-US", "VisualSubtitle", "Card: the customers with a bonus term, split into spent above and within what their sales accumulated, with the spent rate against the rate in the price."},
				        {"Visual", 17, "Alt Bonus Division", "en-US", "VisualSubtitle", "Bar chart: bonus accumulated and spent by division."},
				        {"Visual", 18, "Alt Bonus Month", "en-US", "VisualSubtitle", "Column chart: bonus accumulated and spent by month of the Current Year."},
				        {"Visual", 19, "Alt Bonus Not Given", "en-US", "VisualSubtitle", "Table of customers without a bonus term: their sales and the bonus accumulated on them."},
				        {"Visual", 20, "Alt Bonus Risks", "en-US", "VisualSubtitle", "Card: customers spent above their accumulation and by how much, the spent rate, and the bonus accumulated on customers without a bonus term."},
				        {"Visual", 21, "Alt Bonus Spent", "en-US", "VisualSubtitle", "Card: the bonus spent so far in the Current Year."},
				        {"Visual", 22, "Alt Bonus Spent Rate", "en-US", "VisualSubtitle", "Card: bonus spent as a share of bonus accumulated, with the spent rate against the rate in the price and the difference between them."},
				        {"Visual", 23, "Alt Brand Tooltip", "en-US", "VisualSubtitle", "Table for the brand or product under the pointer: sales, margin, budget spent and accumulated, extra discount, and the price and volume effects."},
