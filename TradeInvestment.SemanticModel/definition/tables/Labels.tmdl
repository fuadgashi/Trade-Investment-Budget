				        {"Visual", 25, "Alt Budget Marketing", "en-US", "VisualSubtitle", "Table by brand and product: sales and marketing accumulated."},
				        {"Visual", 26, "Alt Budget Month", "en-US", "VisualSubtitle", "Table by month: marketing accumulated, credit notes received, budget accumulated, credit notes issued, extra discount, budget spent and difference."},
