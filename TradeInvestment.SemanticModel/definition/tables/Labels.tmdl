/// Every user-facing string of the report: one row per owner, label type and culture. Plain data; the label measures read it.
table Labels
	lineageTag: 9f7b0fcb-ddf7-468f-b948-a5a954a2f9f6

	/// What the label belongs to - a page, a section, a visual or a slicer.
	column OwnerType
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: a09bda47-b5bd-4af1-aa9b-f3f9bcacfe4a
		summarizeBy: none
		sourceColumn: OwnerType

		annotation SummarizationSetBy = Automatic

	/// Sequential number within the owner type. Never shared across types.
	column OwnerNumber
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 7baaf915-8f4c-4947-ac16-637a51cc5a7e
		summarizeBy: none
		sourceColumn: OwnerNumber

		annotation SummarizationSetBy = Automatic

	/// Human-readable name of the thing the label belongs to.
	column OwnerName
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 3a390d67-2146-4523-9f7a-b04979b6a1a9
		summarizeBy: none
		sourceColumn: OwnerName

		annotation SummarizationSetBy = Automatic

	/// Which slot on the owner this text fills, such as a title or a subtitle.
	column LabelType
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 1e99fc90-6b19-4164-bebd-00b277347a48
		summarizeBy: none
		sourceColumn: LabelType

		annotation SummarizationSetBy = Automatic

	/// Language this row's text is written in.
	column Culture
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: cd11650c-9c75-4959-9709-3f9628864946
		summarizeBy: none
		sourceColumn: Culture

		annotation SummarizationSetBy = Automatic

	/// The text shown to the user. All report text lives here, never in DAX.
	column Label
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 92c2a817-98db-4eb3-9387-b959414a2c0b
		summarizeBy: none
		sourceColumn: Label

		annotation SummarizationSetBy = Automatic

	partition Labels = m
		mode: import
		queryGroup: Model
		source =
				let
				    // Every user-facing string of the report, one row per OwnerType + OwnerNumber + LabelType + Culture.
				    // Text lives here, never in DAX: the measures in LabelMeasures are lookups against it.
