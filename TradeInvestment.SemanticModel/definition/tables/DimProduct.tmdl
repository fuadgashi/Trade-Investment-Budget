/// The product catalogue: one row per product, with its brand and packing.
table DimProduct
	lineageTag: 62376ff1-2fa9-4eb2-a9eb-a8e8d03f3838

	/// Product code.
	column ProductId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: bffa6bc9-8e6e-4105-9ab3-3e29854e7d48
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = Automatic

	/// Product name as it appears in the catalogue. Sorted by ProductSortOrder.
	column ProductName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 356c627c-2d34-4781-ae55-f287ad4919ff
		isDefaultLabel
		summarizeBy: none
		sourceColumn: ProductName
		sortByColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of ProductName, from the source: one position per product name.
	column ProductSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c621fe4b-706d-4e3a-9f40-7b138f31cced
		summarizeBy: none
		sourceColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Brand of the product. Joins to DimBrand; blank for a product the brand list leaves out.
	column BrandId
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 8828ea6e-cfd4-435d-bac7-e422b9a7109a
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Pieces in one pack.
	column PiecesPerPack
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 45cd2c54-20a1-4da9-aae6-ebeab3d20a2e
		summarizeBy: none
		sourceColumn: PiecesPerPack

		annotation SummarizationSetBy = Automatic

	/// Packs on one pallet.
	column PacksPerPallet
		dataType: int64
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 42f12897-442e-4a76-9245-fd2e6b96e611
		summarizeBy: none
		sourceColumn: PacksPerPallet

		annotation SummarizationSetBy = Automatic
	partition DimProduct = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // The product catalogue with brand, packing and display order.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    p.ProductId,
				                    p.ProductName,
				                    p.SortOrder AS ProductSortOrder,
				                    p.BrandId,
				                    p.PiecesPerPack,
				                    p.PacksPerPallet
				                FROM ti.Product p
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"ProductId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

